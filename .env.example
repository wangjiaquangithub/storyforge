# Generic fallback API key (optional if provider-specific key is set)
STORYFORGE_API_KEY=

# LLM provider (supported: anthropic, openai)
STORYFORGE_LLM_PROVIDER=anthropic

# Provider-specific API keys
STORYFORGE_ANTHROPIC_API_KEY=
STORYFORGE_OPENAI_API_KEY=

# Model name
STORYFORGE_MODEL=claude-sonnet-4-6-20250514

# Optional provider base URL override (used for OpenAI-compatible endpoints)
STORYFORGE_BASE_URL=

# Request timeout in seconds
STORYFORGE_TIMEOUT_SECONDS=30.0

# Max tokens per request (default: 8192)
STORYFORGE_MAX_TOKENS=8192

# Temperature (default: 0.7)
STORYFORGE_TEMPERATURE=0.7

# Set to 1 to skip LLM calls and use fallback generators (for CI/testing)
STORYFORGE_SKIP_LLM=0
